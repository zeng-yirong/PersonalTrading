{
  "_comment": "预设策略：text 是给人看的原话，query 是可直接执行的等价条件（无需再调模型）。每周全量回测按这里的顺序跑，排名写入 preset_batches。",
  "presets": [
    {
      "id": "low-valuation",
      "label": "低估值蓝筹",
      "text": "市盈率低于15、ROE大于15%、市值超过500亿",
      "query": {
        "title": "低估值蓝筹",
        "filters": [
          {
            "field": "pe_ttm",
            "op": "<=",
            "value": 15
          },
          {
            "field": "roe",
            "op": ">=",
            "value": 15
          },
          {
            "field": "total_mv",
            "op": ">=",
            "value": 50000000000
          }
        ],
        "sort": [
          {
            "field": "roe",
            "desc": true
          }
        ]
      },
      "horizon": "long"
    },
    {
      "id": "growth",
