# PersonalTrading 本地个人交易助手
# 复制为项目根目录 .env 后填写

# 服务监听（只建议本机）
PERSONALTRADING_HOST=127.0.0.1
PERSONALTRADING_PORT=8010

# 数据库（默认项目根目录下 data/）
# PERSONALTRADING_DATABASE_PATH=./data/personaltrading.db     自选/笔记（SQLite）
# PERSONALTRADING_MARKET_DB_PATH=./data/market.duckdb         市场面板（DuckDB）

# DeepSeek（OpenAI 兼容接口）
PERSONALTRADING_DEEPSEEK_API_KEY=
PERSONALTRADING_DEEPSEEK_BASE_URL=https://api.deepseek.com
PERSONALTRADING_DEEPSEEK_MODEL=deepseek-flash

# Tushare Pro（全市场面板的首选数据源；token 从 https://tushare.pro/user/token 复制）
# 留空或 token 无效时会自动降级到新浪 / 东财 / AKShare
PERSONALTRADING_TUSHARE_TOKEN=

# 历史同步参数
PERSONALTRADING_SYNC_CONCURRENCY=4
PERSONALTRADING_SYNC_YEARS=10

# 缓存时间（秒）
PERSONALTRADING_QUOTE_TTL=5
PERSONALTRADING_KLINE_TTL=300
PERSONALTRADING_FUNDAMENTALS_TTL=3600
